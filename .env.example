# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Dashboard login credentials
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme

# ─── Location (for weather) ──────────────────────────────────────────────────
# Fallback only — set your real location in the in-app Settings page instead
NEXT_PUBLIC_LATITUDE=37.7749
NEXT_PUBLIC_LONGITUDE=-122.4194
NEXT_PUBLIC_LOCATION_NAME=San Francisco

# ─── Home Assistant ──────────────────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# ─── Google Calendar ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── iCloud Calendar (CalDAV) ────────────────────────────────────────────────
# Use an App-Specific Password from appleid.apple.com
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
